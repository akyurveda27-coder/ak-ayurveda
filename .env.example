# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required — server-side writes from the admin panel bypass RLS with this key.
# Supabase → Settings → API → service_role. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required — admin panel password, verified server-side.
# Without it, nobody can log in to /admin.
ADMIN_PASSWORD=choose-a-strong-password

# Optional — signs the admin session cookie. Defaults to ADMIN_PASSWORD.
# Set it to log everyone out without changing the password.
ADMIN_SESSION_SECRET=any-long-random-string

# Required for appointment confirmation emails (resend.com)
RESEND_API_KEY=your-resend-key
